[Desktop Entry]
Version=1.0
Type=Application
Name=Mount VHDX
Comment=Mount VHDX with read-write access (automatic)
Icon=vhdx-mount
Exec=/usr/local/bin/mount-vhdx-rw.sh %f
Terminal=false
MimeType=application/x-vhdx;application/vnd.ms-vhdx;application/x-vhdx-disk;
Categories=System;FileTools;
Keywords=vhdx;mount;disk;virtual;
NoDisplay=false
